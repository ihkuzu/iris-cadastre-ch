# Copy to .env. Only staging schemas are accepted (iris_staging or iris_staging_<name>).
IRIS_DATABASE_URL=postgresql+psycopg://iris:iris@localhost:5434/iris_staging
IRIS_DB_SCHEMA=iris_staging
POSTGRES_PASSWORD=iris

# Linux: your user and group id (id -u, id -g), so the container can write data/, logs/, results/, docs/
IRIS_UID=1000
IRIS_GID=1000
